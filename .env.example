# ---- Database (PostgreSQL langsung; BUKAN URL REST Supabase) ----
# Lokal : postgresql+psycopg://cinelist_user:password@localhost:5432/cinelist
# Supabase sebagai server Postgres: Project Settings > Database > Connection string
#   (pakai "Session pooler" bila jaringan tidak mendukung IPv6), awalan diganti postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://cinelist_user:replace_me@localhost:5432/cinelist

# ---- Keamanan ----
# Wajib, minimal 32 karakter acak. Buat: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PENTING: nilai di bawah ini hanya contoh. Aplikasi MENOLAK start bila masih berisi "replace_"/"example" dsb.
SECRET_KEY=replace_with_a_private_random_secret_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Batas login gagal dalam satu jendela waktu -> HTTP 429.
#   LOGIN_MAX_ATTEMPTS    : per (IP + email), menahan tebak password satu akun
#   LOGIN_IP_MAX_ATTEMPTS : per IP untuk semua email, menahan password spraying
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_WINDOW_SECONDS=300

# ---- Aplikasi ----
APP_ENV=development            # production = /docs dan /openapi.json dimatikan
APP_PORT=8000
# Daftar origin frontend (pisah koma). Tidak boleh "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Opsional ----
TMDB_API_KEY=your_tmdb_api_key_here   # hanya untuk scripts/seed_movies.py

# ---- Tes integrasi (opsional, wajib database KHUSUS tes; namanya harus mengandung "test") ----
# TEST_DATABASE_URL=postgresql+psycopg://cinelist_user:replace_me@localhost:5432/cinelist_test
